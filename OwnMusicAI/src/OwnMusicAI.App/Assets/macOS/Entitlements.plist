<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- no sandbox: the app downloads models and writes songs wherever the user points it -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- the .NET runtime needs JIT under the hardened runtime -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- native libs from NuGet and the Rust engines aren't signed by the same team -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
