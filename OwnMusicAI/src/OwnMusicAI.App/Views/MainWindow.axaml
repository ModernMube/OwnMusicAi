<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OwnMusicAI.App.ViewModels"
        xmlns:views="using:OwnMusicAI.App.Views"
        xmlns:mi="using:Material.Icons.Avalonia"
        x:Class="OwnMusicAI.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="OwnMusicAI"
        Width="1360" Height="900" MinWidth="1060" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True">

    <Grid RowDefinitions="*,Auto">

        <Grid ColumnDefinitions="470,*">

            <!-- create side -->
            <Border Background="{DynamicResource PanelBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,18,20,10" Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentGradient}">
                                <mi:MaterialIcon Kind="MusicNote" Width="20" Height="20" Foreground="White"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="h1" Text="OwnMusicAI" FontSize="19"/>
                                <TextBlock Classes="muted" Text="YuE2 + SheetSage2 on your own machine"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Background="{DynamicResource InputBrush}" CornerRadius="20" Padding="4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Classes="tab" GroupName="page" Content="Simple" IsChecked="{Binding IsSimplePage}"/>
                                <RadioButton Classes="tab" GroupName="page" Content="Advanced" IsChecked="{Binding IsAdvancedPage}"/>
                                <RadioButton Classes="tab" GroupName="page" Content="Settings" IsChecked="{Binding IsSettingsPage}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#33FF5A6A" CornerRadius="10" Padding="12,8"
                                IsVisible="{Binding ModelProblem, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <DockPanel>
                                <mi:MaterialIcon Kind="AlertCircleOutline" Width="18" Height="18" Margin="0,0,8,0"
                                                 Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding ModelProblem}" TextWrapping="Wrap" FontSize="12"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- create button + status -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="20,10,20,16" Spacing="8">
                        <Button Classes="cta" HorizontalAlignment="Stretch" Command="{Binding CreateCommand}"
                                IsVisible="{Binding IsCreatePage}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="MusicNote" Width="18" Height="18"/>
                                <TextBlock Text="Create" FontSize="15"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Classes.error="{Binding StatusIsError}"
                                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>

                    <ScrollViewer Padding="20,4,20,8">
                        <Panel>
                            <views:SimplePanel IsVisible="{Binding IsSimplePage}"/>
                            <views:AdvancedPanel IsVisible="{Binding IsAdvancedPage}"/>
                            <views:SettingsPanel IsVisible="{Binding IsSettingsPage}"/>
                        </Panel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- library -->
            <DockPanel Grid.Column="1" Margin="24,18,16,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding OpenLibraryFolderCommand}"
                            ToolTip.Tip="Open the song folder">
                        <mi:MaterialIcon Kind="FolderOpenOutline" Width="18" Height="18"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Classes="h1" Text="Library"/>
                        <TextBlock Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                   Text="{Binding Songs.Count, StringFormat='{}{0} songs'}"/>
                    </StackPanel>
                </DockPanel>

                <Panel>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                                IsVisible="{Binding !Songs.Count}">
                        <mi:MaterialIcon Kind="PlaylistMusic" Width="48" Height="48" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Classes="muted" FontSize="14" TextAlignment="Center"
                                   Text="Your songs show up here.&#10;Drop an audio file anywhere to make it the reference song."/>
                    </StackPanel>

                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Songs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SongItemViewModel">
                                    <Border Classes="song" Margin="0,0,8,4">
                                        <Grid ColumnDefinitions="72,*,Auto">

                                            <!-- cover, doubles as the play button -->
                                            <Button Width="60" Height="60" Padding="0" CornerRadius="10"
                                                    Background="{Binding Cover}" Command="{Binding PlayCommand}"
                                                    IsEnabled="{Binding IsDone}" VerticalAlignment="Top">
                                                <Panel>
                                                    <mi:MaterialIcon Kind="Play" Width="28" Height="28" Foreground="White"
                                                                     IsVisible="{Binding IsDone}"/>
                                                    <mi:MaterialIcon Kind="MusicNote" Width="24" Height="24" Foreground="#AAFFFFFF"
                                                                     IsVisible="{Binding !IsDone}"/>
                                                </Panel>
                                            </Button>

                                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DurationText}" Classes="muted" VerticalAlignment="Center"/>
                                                    <Border CornerRadius="6" Padding="6,1" Background="{DynamicResource CardHoverBrush}"
                                                            IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Style}" Classes="muted" FontSize="13"
                                                           Foreground="{DynamicResource TextBrush}" Opacity="0.75"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Meta}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis"/>

                                                <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding IsBusy}">
                                                    <TextBlock Text="{Binding StageText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Value="{Binding Progress}" Maximum="100"
                                                                 IsIndeterminate="{Binding IsIndeterminate}"/>
                                                </StackPanel>
                                                <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Classes="ghost" Command="{Binding CancelCommand}" IsVisible="{Binding IsBusy}"
                                                        ToolTip.Tip="Stop">
                                                    <mi:MaterialIcon Kind="StopCircleOutline" Width="20" Height="20"/>
                                                </Button>
                                                <Button Classes="ghost" Command="{Binding ResumeCommand}" IsVisible="{Binding CanResume}"
                                                        ToolTip.Tip="Resume from the last saved phase">
                                                    <mi:MaterialIcon Kind="Replay" Width="20" Height="20"/>
                                                </Button>
                                                <Button Classes="ghost" Command="{Binding ReuseCommand}"
                                                        ToolTip.Tip="Reuse prompt and parameters (Advanced)">
                                                    <mi:MaterialIcon Kind="Tune" Width="20" Height="20"/>
                                                </Button>
                                                <Button Classes="ghost" Command="{Binding UseAsReferenceCommand}" IsVisible="{Binding IsDone}"
                                                        ToolTip.Tip="Cover: make this song the reference">
                                                    <mi:MaterialIcon Kind="AccountMusicOutline" Width="20" Height="20"/>
                                                </Button>
                                                <Button Classes="ghost" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Show the files">
                                                    <mi:MaterialIcon Kind="FolderOpenOutline" Width="20" Height="20"/>
                                                </Button>
                                                <Button Classes="ghost" Command="{Binding DeleteCommand}" ToolTip.Tip="Delete">
                                                    <Panel>
                                                        <mi:MaterialIcon Kind="DeleteOutline" Width="20" Height="20"
                                                                         IsVisible="{Binding !PendingDelete}"/>
                                                        <TextBlock Text="Delete?" Foreground="{DynamicResource ErrorBrush}" FontSize="12"
                                                                   IsVisible="{Binding PendingDelete}"/>
                                                    </Panel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>
            </DockPanel>
        </Grid>

        <views:PlayerBar Grid.Row="1" DataContext="{Binding Player}"/>
    </Grid>
</Window>
