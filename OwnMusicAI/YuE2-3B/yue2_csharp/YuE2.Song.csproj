<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>YuE2.Song</RootNamespace>
    <UseYue2Engine>true</UseYue2Engine>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <!-- audio to ABC score, used by the abc-audio option -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)../../SheetSage2/sheetsage2_csharp/SheetSage2.Transcription/SheetSage2.Transcription.csproj" />
  </ItemGroup>

  <!-- the Rust engine: local cargo build or the CI-built runtimes/; SheetSage2 comes with the reference -->
  <Import Project="$(MSBuildThisFileDirectory)../../NativeEngines.targets" />

</Project>
